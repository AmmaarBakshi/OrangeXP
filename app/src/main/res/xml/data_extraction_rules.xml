<?xml version="1.0" encoding="utf-8"?>
<!-- Personal tracking data is never uploaded to cloud backup. A direct
     device-to-device transfer when setting up a new phone may carry it over. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
