<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Screen, keyguard and foreground-app history: the basis of sleep estimation.
         Granted by the user in system settings ("Usage access"). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Hardware step counter (runtime permission on Android 10+). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Optional walking detection: GPS fixes are recorded only while Android reports
         movement, so walking can be told apart from riding a vehicle. Off by default. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />

    <queries>
        <!-- Needed to recognise launcher packages, whose foreground events are not intentional use. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application>
        <receiver
            android:name=".movement.ActivityTransitionReceiver"
            android:exported="false" />
        <receiver
            android:name=".movement.LocationUpdateReceiver"
            android:exported="false" />
    </application>
</manifest>
